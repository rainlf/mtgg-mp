/* 用户信息组件样式 */
.userinfo-container {
  padding: 16rpx 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 252, 255, 0.98) 100%);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(62, 91, 135, 0.1);
  margin: 20rpx 20rpx 10rpx 20rpx;
  border: 1rpx solid rgba(126, 159, 209, 0.16);
  overflow: hidden;
}

.settings-btn {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #eef5ff 0%, #e4efff 100%);
  border: 1rpx solid rgba(74, 144, 226, 0.14);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.profile-card {
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f6faff 0%, #edf4ff 58%, #fff8eb 100%);
  border: 1rpx solid rgba(101, 149, 224, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.profile-main {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(228, 239, 255, 0.95) 100%);
  box-shadow: 0 6rpx 18rpx rgba(74, 144, 226, 0.1);
  flex-shrink: 0;
  box-sizing: border-box;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.info-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 2rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  margin-bottom: 14rpx;
}

.identity-block {
  flex: 1;
  width: auto;
  min-width: 0;
  display: flex;
  align-items: center;
  min-height: 80rpx;
}

.username {
  display: block;
  width: 100%;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2f45;
  line-height: 1.1;
  letter-spacing: 0.4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.points-box {
  width: auto;
  min-width: 198rpx;
  margin-left: auto;
  height: 72rpx;
  padding: 0 14rpx 0 12rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 251, 242, 0.98) 0%, rgba(255, 240, 204, 0.98) 100%);
  border: 1rpx solid rgba(255, 183, 77, 0.24);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow:
    0 4rpx 10rpx rgba(255, 183, 77, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.58);
}

.shop-entry {
  width: 64rpx;
  height: 64rpx;
  margin-left: 8rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #fff5fb 0%, #ffe6f3 100%);
  border: 1rpx solid rgba(228, 124, 170, 0.2);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow:
    0 4rpx 12rpx rgba(228, 124, 170, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.58);
}

.shop-entry:active {
  transform: scale(0.98);
  opacity: 0.94;
}

.shop-entry__label {
  font-size: 17rpx;
  line-height: 1.1;
  font-weight: 600;
  color: #b04d78;
}

.points-meta {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  column-gap: 6rpx;
  flex-shrink: 0;
  transform: translateY(1rpx);
}

.coin-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd66b 0%, #ffb300 100%);
  border: 1rpx solid rgba(214, 144, 0, 0.35);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 248, 220, 0.8),
    0 2rpx 4rpx rgba(255, 183, 77, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.coin-icon-inner {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: rgba(255, 241, 196, 0.75);
}

.points-label {
  display: block;
  margin-left: 0;
  font-size: 20rpx;
  color: #7d6546;
  line-height: 1.1;
  font-weight: 600;
  opacity: 0.92;
  white-space: nowrap;
}

.points {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 78rpx;
  text-align: right;
  font-size: 34rpx;
  color: #ff9900;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.stats-panel {
  display: flex;
  align-items: stretch;
  margin-top: 2rpx;
}

.stat-item + .stat-item {
  margin-left: 10rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
  min-height: 92rpx;
  padding: 14rpx 10rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  border-radius: 13rpx;
  background: linear-gradient(180deg, #fbfdff 0%, #f1f6fd 100%);
  border: 1rpx solid rgba(93, 131, 191, 0.14);
  box-shadow: 0 3rpx 8rpx rgba(86, 115, 156, 0.05);
}

.stats-panel .stat-item:nth-child(1) {
  background: linear-gradient(180deg, #effcff 0%, #d6f5ff 100%);
  border-color: rgba(0, 162, 194, 0.22);
  box-shadow: 0 4rpx 10rpx rgba(0, 162, 194, 0.08);
}

.stats-panel .stat-item:nth-child(1) .stat-label {
  color: #4f8b9c;
}

.stats-panel .stat-item:nth-child(1) .stat-value {
  color: #0f6e82;
}

.stats-panel .stat-item:nth-child(2) {
  background: linear-gradient(180deg, #f7f5ff 0%, #ece8ff 100%);
  border-color: rgba(132, 118, 230, 0.24);
  box-shadow: 0 4rpx 10rpx rgba(132, 118, 230, 0.08);
}

.stats-panel .stat-item:nth-child(2) .stat-label {
  color: #7d72be;
}

.stats-panel .stat-item:nth-child(2) .stat-value {
  color: #5a4db0;
}

.stat-item-highlight {
  position: relative;
  background: linear-gradient(180deg, #fff7e3 0%, #ffe4b0 100%);
  border-color: rgba(222, 164, 62, 0.28);
  box-shadow: 0 4rpx 10rpx rgba(222, 164, 62, 0.1);
}

.stat-item-negative {
  background: linear-gradient(180deg, #fff7e3 0%, #ffe4b0 100%);
  border-color: rgba(222, 164, 62, 0.28);
  box-shadow: 0 4rpx 10rpx rgba(222, 164, 62, 0.1);
}

.stat-value {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #25364e;
  line-height: 1.1;
  text-align: center;
  flex-shrink: 0;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.stat-value-highlight {
  color: #ff9900;
}

.stat-value-negative {
  color: #2f9b63;
}

.stat-label {
  font-size: 24rpx;
  color: #7f8fa5;
  line-height: 1.2;
  font-weight: 500;
  white-space: nowrap;
  text-align: center;
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: 8rpx;
  border-radius: 12rpx;
}

.gear-icon {
  width: 22rpx;
  height: 22rpx;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.settings-btn:active .gear-icon {
  transform: rotate(24deg);
  opacity: 0.96;
}
