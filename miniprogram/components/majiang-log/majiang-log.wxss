.list-container {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 16rpx 20rpx;
    box-sizing: border-box;
    overflow: hidden;
}

.list-content {
    width: 100%;
    min-height: 100%;
}

.panel-banner {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 4rpx 0 18rpx;
    padding: 14rpx 24rpx;
    box-sizing: border-box;
    border-radius: 16rpx;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.panel-banner-history {
    background: linear-gradient(135deg, rgba(245, 242, 255, 0.98) 0%, rgba(252, 249, 255, 0.98) 100%);
    border: 1rpx solid rgba(132, 118, 230, 0.16);
    box-shadow: 0 6rpx 18rpx rgba(132, 118, 230, 0.08);
}

.panel-banner__title {
    font-size: 28rpx;
    font-weight: 700;
    line-height: 1.2;
    color: #453f86;
}

.panel-banner__tabs {
    display: flex;
    width: 100%;
}

.panel-banner__tabs-fitness {
    margin: 0;
}

.panel-banner__tab {
    flex: 1;
    min-height: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12rpx;
    font-size: 26rpx;
    font-weight: 700;
    color: #7a74b3;
    background: rgba(255, 255, 255, 0.62);
    transition: all 0.2s ease;
}

.panel-banner__tab + .panel-banner__tab {
    margin-left: 10rpx;
}

.panel-banner__tab-active {
    color: #5a4db0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(239, 235, 255, 0.98) 100%);
    box-shadow: 0 4rpx 12rpx rgba(132, 118, 230, 0.12);
}

.prize-pool-card {
    margin: 0 0 18rpx;
    padding: 20rpx 24rpx;
    border-radius: 18rpx;
    background: linear-gradient(135deg, rgba(255, 249, 234, 0.98) 0%, rgba(255, 243, 212, 0.98) 100%);
    border: 1rpx solid rgba(229, 173, 61, 0.2);
    box-shadow: 0 8rpx 18rpx rgba(224, 162, 40, 0.08);
    box-sizing: border-box;
}

.prize-pool-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.prize-pool-card__header-right {
    display: flex;
    align-items: center;
}

.prize-pool-card__label {
    font-size: 24rpx;
    font-weight: 700;
    color: #8f5b13;
}

.prize-pool-card__type {
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    font-size: 20rpx;
    line-height: 1;
    color: #9e691d;
    background: rgba(255, 255, 255, 0.6);
}

.prize-pool-card__action {
    margin-left: 10rpx;
    font-size: 22rpx;
    color: #b27b20;
}

.prize-pool-card__body,
.prize-pool-card__loading {
    display: flex;
    align-items: flex-end;
    margin-top: 14rpx;
}

.prize-pool-card__balance {
    font-size: 44rpx;
    line-height: 1;
    font-weight: 700;
    color: #c97800;
}

.prize-pool-card__unit {
    margin-left: 10rpx;
    font-size: 22rpx;
    line-height: 1.2;
    color: #9e691d;
}

.prize-pool-card__spinner {
    width: 26rpx;
    height: 26rpx;
}

.prize-pool-card__hint {
    margin-left: 10rpx;
    font-size: 22rpx;
    color: #9e691d;
}

.prize-pool-detail {
    margin: -6rpx 0 18rpx;
    padding: 18rpx 22rpx;
    border-radius: 16rpx;
    background: rgba(255, 252, 243, 0.98);
    border: 1rpx solid rgba(229, 173, 61, 0.14);
    box-shadow: 0 6rpx 16rpx rgba(224, 162, 40, 0.06);
    box-sizing: border-box;
}

.prize-pool-detail__header,
.prize-pool-detail__loading,
.prize-pool-detail__empty,
.prize-pool-detail__row,
.prize-pool-detail__user {
    display: flex;
    align-items: center;
}

.prize-pool-detail__header {
    justify-content: space-between;
    margin-bottom: 10rpx;
}

.prize-pool-detail__title {
    font-size: 22rpx;
    font-weight: 700;
    color: #8f5b13;
}

.prize-pool-detail__section-title {
    margin-top: 12rpx;
    margin-bottom: 6rpx;
    font-size: 20rpx;
    font-weight: 700;
    color: #9d6718;
}

.prize-pool-detail__section-title--event {
    margin-top: 16rpx;
}

.prize-pool-detail__subtitle,
.prize-pool-detail__hint {
    font-size: 20rpx;
    color: #af7d2f;
}

.prize-pool-detail__spinner {
    width: 24rpx;
    height: 24rpx;
}

.prize-pool-detail__loading,
.prize-pool-detail__empty {
    padding: 12rpx 0 6rpx;
}

.prize-pool-detail__hint {
    margin-left: 10rpx;
}

.prize-pool-detail__row {
    justify-content: space-between;
    padding: 16rpx 0;
}

.prize-pool-detail__row + .prize-pool-detail__row {
    border-top: 1rpx solid rgba(229, 173, 61, 0.12);
}

.prize-pool-detail__user {
    min-width: 0;
    flex: 1;
}

.prize-pool-detail__user--event {
    align-items: flex-start;
}

.prize-pool-detail__avatar {
    width: 50rpx;
    height: 50rpx;
    border-radius: 50%;
    background: #fff;
    flex-shrink: 0;
}

.prize-pool-detail__avatar--placeholder {
    justify-content: center;
    background: linear-gradient(180deg, rgba(255, 242, 204, 0.98) 0%, rgba(255, 225, 164, 0.98) 100%);
}

.prize-pool-detail__avatar-text {
    font-size: 22rpx;
    font-weight: 700;
    color: #b67810;
}

.prize-pool-detail__name {
    margin-left: 14rpx;
    font-size: 24rpx;
    color: #654214;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.prize-pool-detail__event-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.prize-pool-detail__time {
    margin-left: 14rpx;
    margin-top: 6rpx;
    font-size: 20rpx;
    color: #aa8a5d;
}

.prize-pool-detail__points {
    margin-left: 16rpx;
    font-size: 26rpx;
    font-weight: 700;
    color: #d28600;
    flex-shrink: 0;
}

.prize-pool-detail__points--event {
    color: #c66b00;
}

.jackpot-event {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
    padding: 14rpx 18rpx;
    border-radius: 16rpx;
    background: linear-gradient(135deg, rgba(255, 249, 231, 0.98) 0%, rgba(255, 237, 192, 0.98) 100%);
    border: 1rpx solid rgba(224, 171, 64, 0.2);
}

.jackpot-event__badge {
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    font-size: 20rpx;
    font-weight: 700;
    color: #9d650d;
    background: rgba(255, 255, 255, 0.66);
}

.jackpot-event__text {
    flex: 1;
    margin-left: 14rpx;
    font-size: 24rpx;
    color: #7a5115;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.jackpot-event__points {
    margin-left: 12rpx;
    font-size: 28rpx;
    font-weight: 700;
    color: #cf7b00;
    flex-shrink: 0;
}

.panel-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 260rpx;
    padding: 24rpx 0 36rpx;
}

.panel-loading__spinner {
    width: 30rpx;
    height: 30rpx;
}

.panel-loading__text {
    margin-top: 14rpx;
    font-size: 24rpx;
    color: #7c8ea5;
    line-height: 1.2;
}

.panel-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220rpx;
    padding: 10rpx 0 28rpx;
}

.panel-empty__text {
    font-size: 24rpx;
    line-height: 1.3;
    color: #8e86c7;
}

/* 单条记录卡片 */
.record-item {
    margin: 14rpx 0;
    padding: 24rpx;
    border-radius: 20rpx;
    border: 1rpx solid rgba(93, 131, 191, 0.14);
    background: linear-gradient(180deg, #fbfdff 0%, #f2f7fe 100%);
    box-shadow:
        inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
        0 6rpx 18rpx rgba(86, 115, 156, 0.08);
    box-sizing: border-box;
    min-height: 0;
}

.record-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18rpx;
    padding-bottom: 16rpx;
    border-bottom: 2rpx solid rgba(126, 159, 209, 0.12);
}

.record-header-left {
    display: flex;
    align-items: center;
    min-width: 0;
}

.record-header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
}

.record-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 0;
}

.win-type,
.win-type2,
.win-type3 {
    min-width: 92rpx;
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    font-size: 24rpx;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    box-sizing: border-box;
}

.win-type {
    color: #1e8f67;
    background: linear-gradient(180deg, rgba(229, 250, 236, 0.98) 0%, rgba(210, 240, 220, 0.98) 100%);
    border: 1rpx solid rgba(33, 160, 110, 0.14);
}

.win-type2 {
    color: #c46811;
    background: linear-gradient(180deg, rgba(255, 248, 231, 0.98) 0%, rgba(255, 228, 176, 0.98) 100%);
    border: 1rpx solid rgba(222, 164, 62, 0.18);
}

.win-type3 {
    color: #c43c3c;
    background: linear-gradient(180deg, rgba(255, 241, 241, 0.98) 0%, rgba(255, 220, 220, 0.98) 100%);
    border: 1rpx solid rgba(228, 104, 104, 0.18);
}

.player-avatars {
    display: flex;
    align-items: center;
    margin-left: 18rpx;
}

.avatar-small {
    width: 38rpx;
    height: 38rpx;
    margin-left: -10rpx;
    border-radius: 50%;
    border: 2rpx solid rgba(255, 255, 255, 0.98);
    box-shadow: 0 3rpx 8rpx rgba(74, 144, 226, 0.1);
    background: #fff;
}

.avatar-small:first-child {
    margin-left: 0;
}

.game-time {
    margin-top: 6rpx;
    padding: 8rpx 14rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    font-weight: 500;
    line-height: 1;
    color: #6f8198;
    background: rgba(255, 255, 255, 0.82);
    border: 1rpx solid rgba(126, 159, 209, 0.14);
}

.recorder-info {
    font-size: 20rpx;
    line-height: 1.1;
    color: #9aa8b8;
    max-width: 260rpx;
    margin-right: 16rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recorder-pool-info {
    color: #c97800;
    font-weight: 600;
}

.delete-btn {
    margin-left: 14rpx;
    width: 34rpx;
    height: 34rpx;
    padding: 10rpx;
    border-radius: 50%;
    background: linear-gradient(180deg, rgba(255, 245, 245, 0.98) 0%, rgba(255, 235, 235, 0.98) 100%);
    border: 1rpx solid rgba(239, 68, 68, 0.12);
    box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.08);
}

.winner-section,
.loser-section {
    overflow: hidden;
    border-radius: 16rpx;
}

.player-row {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    box-sizing: border-box;
}

.winner-section .player-row + .player-row,
.loser-section .player-row + .player-row {
    border-top: 1rpx solid rgba(126, 159, 209, 0.1);
}

.winner {
    background: linear-gradient(180deg, rgba(255, 249, 249, 0.94) 0%, rgba(255, 244, 244, 0.94) 100%);
}

.loser {
    background: linear-gradient(180deg, rgba(241, 252, 246, 0.94) 0%, rgba(233, 249, 240, 0.94) 100%);
}

.avatar {
    width: 64rpx;
    height: 64rpx;
    margin-right: 18rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 6rpx 16rpx rgba(74, 144, 226, 0.1);
    box-sizing: border-box;
    flex-shrink: 0;
}

.player-info {
    flex: 1;
    min-width: 0;
    margin-right: 16rpx;
}

.nickname {
    display: block;
    margin-bottom: 8rpx;
    font-size: 28rpx;
    font-weight: 700;
    color: #22344b;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    margin-right: -8rpx;
    margin-bottom: -8rpx;
}

.tag {
    padding: 4rpx 14rpx;
    margin-right: 8rpx;
    margin-bottom: 8rpx;
    border-radius: 999rpx;
    font-size: 21rpx;
    line-height: 1.35;
    font-weight: 500;
}

.win-tag {
    color: #4f84c4;
    background: rgba(111, 179, 255, 0.12);
}

.lose-tag {
    color: #4f84c4;
    background: rgba(111, 179, 255, 0.12);
}

.special-red-tag {
    color: #c43c3c;
    background: rgba(255, 107, 107, 0.16);
}

.draw-tag {
    color: #2d5f98;
    background: rgba(74, 144, 226, 0.1);
}

.score-change,
.score-change2 {
    min-width: 104rpx;
    text-align: right;
    font-size: 34rpx;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
}

.score-change {
    color: #ff9900;
    text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.42);
}

.score-change-fitness {
    color: #4a90e2;
}

.score-change2 {
    color: #2f9b63;
    text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.42);
}

.loading-more,
.no-more-data {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18rpx 0 10rpx;
    font-size: 24rpx;
    color: #7c8ea5;
}

.loading-spinner {
    width: 24rpx;
    height: 24rpx;
    margin-right: 12rpx;
    border-radius: 50%;
    border: 3rpx solid rgba(74, 144, 226, 0.18);
    border-top-color: #ffb300;
    border-right-color: #4a90e2;
    box-sizing: border-box;
    animation: log-spin 0.9s linear infinite;
}

@keyframes log-spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

@media screen and (max-width: 375rpx) {
    .list-container {
        margin: 5rpx 10rpx 10rpx 10rpx;
        padding: 14rpx 16rpx;
    }

    .record-item {
        padding: 20rpx;
    }

    .win-type,
    .win-type2,
    .win-type3 {
        min-width: 82rpx;
        padding: 8rpx 14rpx;
        font-size: 22rpx;
    }

    .recorder-info {
        max-width: 220rpx;
        font-size: 18rpx;
    }

    .nickname {
        font-size: 26rpx;
    }

    .score-change,
    .score-change2 {
        min-width: 92rpx;
        font-size: 30rpx;
    }
}
