<block>
  <image class="page-bg" src="/images/background.png" mode="aspectFill" />
  <view class="page-bg-mask"></view>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    refresher-enabled
    refresher-default-style="none"
    refresher-triggered="{{isPageRefreshing}}"
    bindrefresherrefresh="onPageRefresh"
  >
  <view class="container">
    <view wx:if="{{isPageRefreshing}}" class="pull-refresh-tip">
      <view class="pull-refresh-tip__spinner"></view>
      <text class="pull-refresh-tip__text">正在刷新用户信息与排行</text>
    </view>

    <view class="top-container">
      <!-- userinfo 组件 -->
      <userinfo
        class="user-info"
        username="{{user.username}}"
        points="{{user.points}}"
        avatar="{{user.avatar}}"
        totalGames="{{user.totalGames}}"
        winCount="{{user.winCount}}"
        winRate="{{user.winRate}}"
        bind:settingsclick="openProfileEditor"
      />

      <block wx:if="{{showUserRank}}">
        <rank
          class="content-panel"
          listData="{{rankList}}"
          isInitialLoading="{{rankLoading}}"
          bind:load="handleRankListLoad"
          bind:clickUserAvatar="handleClickUserAvatar"
        />
      </block>

      <block wx:if="{{showGameLog}}">
        <majiang-log
          class="content-panel"
          id="game-log-component"
          title="{{historyTitle}}"
          emptyText="{{historyEmptyText}}"
          isInitialLoading="{{historyLoading}}"
          prizePoolInfo="{{prizePoolInfo}}"
          prizePoolLoading="{{prizePoolLoading}}"
          listData="{{gameList}}"
          hasMoreData="{{hasMoreData}}"
          bind:load="handleGameListLoad"
          bind:refreshData="handleCurrentHistoryRefresh"
          bind:loadMore="handleLoadMore"
        />
      </block>

      <block wx:if="{{showUserGameLog}}">
        <majiang-log
          class="content-panel"
          id="user-game-log-component"
          title="{{historyTitle}}"
          emptyText="{{historyEmptyText}}"
          isInitialLoading="{{historyLoading}}"
          prizePoolInfo="{{prizePoolInfo}}"
          prizePoolLoading="{{prizePoolLoading}}"
          listData="{{userGameList}}"
          hasMoreData="{{hasMoreData}}"
          bind:load="handleUserGameListLoad"
          bind:refreshData="handleCurrentHistoryRefresh"
          bind:loadMore="handleLoadMore"
        />
      </block>
    </view>

    <view class="bottom-container">
      <view
        class="nav-btn nav-btn-rank {{showUserRank ? 'nav-btn-active nav-btn-rank-active' : ''}}"
        catch:tap="openUserRank"
      >
        <text class="nav-btn-title">玩家排行</text>
      </view>

      <view
        class="nav-btn nav-btn-history {{(showGameLog || showUserGameLog) ? 'nav-btn-active nav-btn-history-active' : ''}}"
        catch:tap="openGameLog"
      >
        <text class="nav-btn-title">游戏历史</text>
      </view>

      <view
        class="nav-btn nav-btn-record {{showDrawer ? 'nav-btn-active nav-btn-record-active' : ''}}"
        catch:tap="openRecordGame"
      >
        <text class="nav-btn-title">记录游戏</text>
      </view>

      <view
        class="nav-btn nav-btn-squat {{showSquatPopup ? 'nav-btn-active nav-btn-squat-active' : ''}}"
        catch:tap="openSquatPopup"
      >
        <text class="nav-btn-title">深蹲</text>
      </view>
    </view>

    <view class="game-container">
      <majiang-game showDrawer="{{showDrawer}}" bind:refreshData="refreshData" bind:closeDrawer="handleCloseDrawer" />
    </view>

    <view wx:if="{{showProfileDrawer}}" class="profile-drawer-container">
      <view class="profile-drawer-mask" bindtap="closeProfileEditor"></view>
      <view class="profile-drawer">
        <view class="profile-drawer-handle"></view>
        <view class="profile-drawer-header">
          <text class="profile-drawer-title">修改资料</text>
          <view class="profile-drawer-close" bindtap="closeProfileEditor">关闭</view>
        </view>

        <view class="profile-drawer-body">
          <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onProfileChooseAvatar">
            <image
              wx:if="{{profileAvatarUrl || user.avatar}}"
              class="profile-avatar"
              src="{{profileAvatarUrl || user.avatar}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="profile-avatar profile-avatar-placeholder">+</view>
          </button>
          <text class="profile-avatar-tip">点击更换头像</text>

          <view class="profile-input-box">
            <input
              type="nickname"
              class="profile-nickname-input"
              placeholder="请输入昵称，最多4字"
              placeholder-class="profile-nickname-placeholder"
              maxlength="4"
              bindinput="onProfileNicknameInput"
              value="{{profileNickname}}"
            />
          </view>
        </view>

        <view class="profile-drawer-footer">
          <view class="profile-footer-btn profile-footer-btn-cancel" bindtap="closeProfileEditor">取消</view>
          <view class="profile-footer-btn profile-footer-btn-confirm" bindtap="saveProfile">
            {{isProfileSaving ? '保存中...' : '保存'}}
          </view>
        </view>
      </view>
    </view>

  </view>
  </scroll-view>

  <view wx:if="{{showSquatPopup}}" class="squat-popup-container">
    <view class="squat-popup-mask" catch:tap="noop"></view>
    <view class="squat-popup" catch:tap="noop">
      <view class="squat-popup-handle"></view>
      <text class="squat-popup-title">当前深蹲次数</text>
      <text class="squat-popup-count {{squatCount >= 10 ? 'squat-popup-count-hit' : ''}}">{{squatCount}}</text>
      <view class="squat-popup-tip">
        <block wx:if="{{squatCount < 100}}">
          <text>保持手机竖直握在胸前，完成一次下蹲起立记 </text>
          <text class="squat-popup-tip-highlight {{squatCount >= 10 ? 'squat-popup-tip-highlight-hit' : ''}}">+{{squatStep}}</text>
          <text> 次</text>
        </block>
        <block wx:else>
          <text class="squat-popup-tip-rest">完美，已经做得足够多了，该休息休息了</text>
        </block>
      </view>
      <view class="squat-popup-footer">
        <view class="squat-popup-btn squat-popup-btn-redeem {{isSquatRedeeming ? 'squat-popup-btn-disabled' : ''}}" bindtap="redeemSquatPoints">
          {{isSquatRedeeming ? '兑换中...' : '兑换'}}
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showSquatConfirm}}" class="squat-confirm-container">
    <view class="squat-confirm-mask" catch:tap="noop"></view>
    <view class="squat-confirm" catch:tap="noop">
      <view class="squat-confirm-icon">金</view>
      <view class="squat-confirm-title">
        <text>是否要兑换 </text>
        <text class="squat-confirm-amount {{squatConfirmCount >= 10 ? 'squat-confirm-amount-hit' : ''}}">+{{squatConfirmCount}}</text>
        <text class="squat-confirm-amount {{squatConfirmCount >= 10 ? 'squat-confirm-amount-hit' : ''}}"> 金币</text>
      </view>
      <text class="squat-confirm-tip {{squatConfirmCount >= 10 ? 'squat-confirm-tip-hit' : ''}}">继续下去也许会有惊喜哦</text>
      <view class="squat-confirm-footer">
        <view class="squat-confirm-btn squat-confirm-btn-cancel" bindtap="cancelSquatRedeem">再想想</view>
        <view class="squat-confirm-btn squat-confirm-btn-confirm" bindtap="confirmSquatRedeem">
          {{isSquatRedeeming ? '兑换中...' : '确认兑换'}}
        </view>
      </view>
    </view>
  </view>
</block>
