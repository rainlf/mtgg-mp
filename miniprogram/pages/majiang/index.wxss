/* 页面整体布局 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background: transparent;
  overflow: hidden;
}

.page-bg {
  /* Skyline 下 fixed 背景层更容易和滚动容器发生层级/绘制异常，这里改为 absolute。 */
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.page-bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(255, 255, 255, 0.14) 45%,
    rgba(255, 255, 255, 0.22) 100%
  );
}

.page-scroll {
  height: 100vh;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.container {
  height: 100vh;
  padding: 75px 0 0 0;
  display: flex;
  flex-direction: column;
  position: relative;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.pull-refresh-tip {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 12rpx);
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(255, 251, 242, 0.98) 0%, rgba(239, 248, 255, 0.98) 100%);
  border: 1rpx solid rgba(126, 159, 209, 0.18);
  box-shadow: 0 8rpx 22rpx rgba(62, 91, 135, 0.12);
}

.pull-refresh-tip__spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(74, 144, 226, 0.18);
  border-top-color: #ffb300;
  border-right-color: #4a90e2;
  box-sizing: border-box;
  animation: pull-refresh-spin 0.9s linear infinite;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.pull-refresh-tip__text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #516882;
  white-space: nowrap;
}

@keyframes pull-refresh-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.top-container {
  width: 100%;
  display: flex;
  flex: 1;
  flex-direction: column;
  position: relative;
  z-index: 1;
  justify-content: flex-start;
  min-height: 0;
  overflow: hidden;
  /* 预留底部栏自身高度，并给中间面板与底部栏之间留出更舒展的间距。 */
  padding-bottom: 116rpx;
  box-sizing: border-box;
}

.bottom-container {
  /* 放在页面容器内绝对定位，避免 viewport fixed 在 Skyline 真机上的不稳定表现。 */
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 0;
  width: auto;
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  z-index: 2;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 251, 255, 0.96) 100%);
  border: 1rpx solid rgba(126, 159, 209, 0.16);
  box-shadow: 0 8rpx 22rpx rgba(62, 91, 135, 0.1);
  gap: 12rpx;
}

.content-panel {
  flex: 1;
  min-height: 0;
  /* 让内部 scroll-view 能拿到剩余高度，避免在 Skyline 下被算成 auto/0。 */
  height: 0;
  display: block;
  margin: 10rpx 20rpx 20rpx 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(126, 159, 209, 0.16);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 251, 255, 0.98) 100%);
  box-shadow: 0 8rpx 22rpx rgba(62, 91, 135, 0.1);
  box-sizing: border-box;
  overflow: hidden;
}

.nav-btn {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  padding: 10rpx 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(126, 159, 209, 0.16);
  box-shadow: 0 4rpx 12rpx rgba(86, 115, 156, 0.06);
  box-sizing: border-box;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.nav-btn + .nav-btn {
  margin-left: 0;
}

.nav-btn-title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #31445c;
  white-space: nowrap;
}

.nav-btn-rank {
  background: linear-gradient(180deg, #f2fbff 0%, #e5f6ff 100%);
  border-color: rgba(0, 162, 194, 0.14);
}

.nav-btn-rank .nav-btn-title {
  color: #4a8192;
}

.nav-btn-history {
  flex: 1.35;
  padding-left: 14rpx;
  padding-right: 14rpx;
  background: linear-gradient(180deg, #f7f4ff 0%, #efebff 100%);
  border-color: rgba(132, 118, 230, 0.14);
}

.nav-btn-history .nav-btn-title {
  color: #6c63a8;
}

.nav-btn-active {
  transform: translateY(-1rpx);
}

.nav-btn-rank-active {
  background: linear-gradient(180deg, #eefaff 0%, #dff4ff 100%);
  border-color: rgba(0, 162, 194, 0.22);
  box-shadow: 0 8rpx 20rpx rgba(0, 162, 194, 0.12);
}

.nav-btn-rank-active .nav-btn-title {
  color: #0f6e82;
}

.nav-btn-history-active {
  background: linear-gradient(180deg, #f5f3ff 0%, #ece8ff 100%);
  border-color: rgba(132, 118, 230, 0.2);
  box-shadow: 0 8rpx 20rpx rgba(132, 118, 230, 0.12);
}

.nav-btn-history-active .nav-btn-title {
  color: #5a4db0;
}

.nav-btn-record {
  background: linear-gradient(135deg, #ffd86d 0%, #ffb300 100%);
  border-color: rgba(214, 144, 0, 0.2);
  box-shadow: 0 8rpx 20rpx rgba(255, 183, 77, 0.2);
}

.nav-btn-record .nav-btn-title {
  color: #fff;
}

.nav-btn-record-active {
  box-shadow: 0 10rpx 24rpx rgba(255, 183, 77, 0.28);
}

.nav-btn-squat {
  background: linear-gradient(135deg, #7fe7c4 0%, #16c784 100%);
  border-color: rgba(20, 167, 108, 0.22);
  box-shadow: 0 8rpx 20rpx rgba(22, 199, 132, 0.18);
}

.nav-btn-squat .nav-btn-title {
  color: #fff;
}

.nav-btn-squat-active {
  box-shadow: 0 10rpx 24rpx rgba(22, 199, 132, 0.28);
}

.nav-btn-fitness {
  background: linear-gradient(135deg, #e9f7ff 0%, #cdeeff 100%);
  border-color: rgba(79, 145, 214, 0.2);
  box-shadow: 0 8rpx 20rpx rgba(79, 145, 214, 0.14);
}

.nav-btn-fitness .nav-btn-title {
  color: #2d79a8;
}

.nav-btn-fitness-active {
  background: linear-gradient(135deg, #def4ff 0%, #b9e7ff 100%);
  border-color: rgba(79, 145, 214, 0.26);
  box-shadow: 0 10rpx 24rpx rgba(79, 145, 214, 0.22);
}

.nav-btn-fitness-active .nav-btn-title {
  color: #175e8c;
}

.profile-drawer-container {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 12;
}

.profile-drawer-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
}

.profile-drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(247, 250, 255, 0.99) 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -14rpx 42rpx rgba(49, 68, 92, 0.18);
  padding: 12rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
}

.profile-drawer-handle {
  width: 88rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(126, 159, 209, 0.35);
  margin: 4rpx auto 14rpx;
}

.profile-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
}

.profile-drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2f45;
}

.profile-drawer-close {
  margin-left: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(74, 144, 226, 0.08);
  border: 1rpx solid rgba(126, 159, 209, 0.16);
  color: #4a8192;
  font-size: 22rpx;
