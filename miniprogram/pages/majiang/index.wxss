.profile-avatar-tip {
  color: rgba(79, 99, 124, 0.72);
  font-size: 24rpx;
  margin-top: 16rpx;
  margin-bottom: 36rpx;
}

.profile-input-box {
  width: 100%;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(126, 159, 209, 0.24);
  box-shadow: 0 8rpx 22rpx rgba(16, 31, 54, 0.08);
