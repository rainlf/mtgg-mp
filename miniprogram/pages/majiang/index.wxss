}

.profile-drawer-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx 24rpx;
}

.profile-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.profile-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  color: rgba(255, 255, 255, 0.4);
  background-color: rgba(255, 255, 255, 0.12);
